{
    "name": "ebremer/lws-drupal",
    "description": "W3C Linked Web Storage (LWS) 1.0 server for Drupal 11.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "keywords": ["drupal", "linked web storage", "lws", "w3c"],
    "homepage": "https://github.com/ebremer/lws-drupal",
    "authors": [
        {
            "name": "Erich Bremer"
        }
    ],
    "support": {
        "issues": "https://github.com/ebremer/lws-drupal/issues",
        "source": "https://github.com/ebremer/lws-drupal"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ebremer/lws-client"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-zlib": "*",
        "drupal/core": "^11.3",
        "ebremer/lws-client": "dev-main",
        "pietercolpaert/hardf": "^0.6"
    },
    "extra": {
        "installer-name": "lws"
    }
}
