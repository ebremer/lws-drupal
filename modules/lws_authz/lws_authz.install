<?php

/**
 * @file
 * Install and update functions for LWS Authorization.
 */

declare(strict_types=1);

use Drupal\lws\Database\SchemaUpdates;

/**
 * Adds the access policy entity type (step A3).
 */
function lws_authz_update_11001(): string {
  $updates = \Drupal::entityDefinitionUpdateManager();
  if ($updates->getEntityType('lws_policy') !== NULL) {
    return 'Access policies were already installed.';
  }
  $type = \Drupal::entityTypeManager()->getDefinition('lws_policy');
  $updates->installEntityType($type);
  return 'Installed access policies.';
}

/**
 * Adds the access request and grant entity type (step A4).
 */
function lws_authz_update_11002(): string {
  $updates = \Drupal::entityDefinitionUpdateManager();
  if ($updates->getEntityType('lws_access') !== NULL) {
    return 'Access requests and grants were already installed.';
  }
  $updates->installEntityType(\Drupal::entityTypeManager()->getDefinition('lws_access'));
  \Drupal::configFactory()->getEditable('lws_authz.settings')->set('rate_limits.access_requests', 30)->save();
  return 'Installed access requests and grants.';
}

/**
 * Adds the settings of the OpenID Connect suite (step A5).
 *
 * The suite stays off on existing sites until it is enabled in the
 * authorization settings.
 */
function lws_authz_update_11003(): string {
  $settings = \Drupal::configFactory()->getEditable('lws_authz.settings');
  if ($settings->get('openid') !== NULL) {
    return 'The OpenID Connect suite was already configured.';
  }
  $settings->set('openid', ['discovery' => TRUE, 'require_as_audience' => TRUE])->save();
  return 'Added the settings of the OpenID Connect suite. Enable it in the authorization settings to accept ID Tokens.';
}

/**
 * Lets access policies end after 2038: not_after becomes a big integer.
 *
 * MySQL and MariaDB refused a grant whose dateTime constraint ends after
 * 2038-01-19 for an integer out of range.
 */
function lws_authz_update_11004(): string {
  $widened = SchemaUpdates::widenToBigInteger(\Drupal::database(), \Drupal::keyValue('entity.storage_schema.sql'), 'lws_policy', 'lws_policy', 'not_after');
  return $widened ? 'Access policies may now end after 2038.' : 'Access policies could already end after 2038.';
}
