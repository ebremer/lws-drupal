<?php

/**
 * @file
 * Install, update and uninstall functions for LWS Notifications.
 */

declare(strict_types=1);

use Drupal\lws\Database\SchemaUpdates;
use Drupal\lws_notify\Delivery\Deliverer;

/**
 * Implements hook_uninstall().
 *
 * Deliveries waiting for cron go with the module. The webhook signing keys
 * stay in their directory, for a reinstall to use.
 */
function lws_notify_uninstall(): void {
  \Drupal::queue(Deliverer::QUEUE)->deleteQueue();
}

/**
 * Lets subscriptions expire after 2038: "expires" becomes a big integer.
 *
 * Without a longest lifetime, MySQL and MariaDB refused a subscription that
 * asked to expire after 2038-01-19 for an integer out of range.
 */
function lws_notify_update_11001(): string {
  $widened = SchemaUpdates::widenToBigInteger(\Drupal::database(), \Drupal::keyValue('entity.storage_schema.sql'), 'lws_subscription', 'lws_subscription', 'expires');
  return $widened ? 'Subscriptions may now expire after 2038.' : 'Subscriptions could already expire after 2038.';
}
